msgid "Tasks needs terminal"
msgstr "ລາຍການວຽກຕ້ອງໃຊ້ເທີມີນໍ"

#: schemas/org.mate.applications-office.gschema.xml:27
msgid "Whether the default tasks application needs a terminal to run"
msgstr "ກຳນົດວ່າແອັບຈັດການວຽກເລີ່ມຕົ້ນຕ້ອງໃຊ້ເທີມີນໍໃນການທຳງານຫຼືບໍ່"

#: schemas/org.mate.applications-terminal.gschema.xml:5
msgid "Terminal application"
msgstr "ແອັບພລິເຄຊັນເທີມີນໍ"

#: schemas/org.mate.applications-terminal.gschema.xml:6
msgid "Terminal program to use when starting applications that require one."
msgstr "ໂປຣແກຣມເທີມີນໍທີ່ຈະໃຊ້ ເມື່ອມີແອັບພລິເຄຊັນອື່ນຮ້ອງຂໍ."

#: schemas/org.mate.applications-terminal.gschema.xml:10
msgid "Exec Arguments"
msgstr "ພາຣາມິເຕີໃນການຮ້ອງໃຊ້ (Exec Arguments)"

#: schemas/org.mate.applications-terminal.gschema.xml:11
msgid ""
"Argument used to execute programs in the terminal defined by the 'exec' key."
msgstr "ອາກິວເມນທີ່ຈະໃຊ້ໃນການເປີດໂປຣແກຣມໃນເທີມີນໍ ຕາມທີ່ກຳນົດໂດຍຄີ 'exec'."

#: schemas/org.mate.background.gschema.xml.in:18
msgid "Draw Desktop Background"
msgstr "ສະແດງພາບພື້ນຫຼັງເດັສທັອບ"

#: schemas/org.mate.background.gschema.xml.in:19
msgid "Have MATE draw the desktop background."
msgstr "ໃຫ້ MATE ເປັນຜູ້ສະແດງພາບພື້ນຫຼັງເດັສທັອບ."

#: schemas/org.mate.background.gschema.xml.in:23
msgid "Show Desktop Icons"
msgstr "ສະແດງໄອຄອນເທິງເດັສທັອບ"

#: schemas/org.mate.background.gschema.xml.in:24
msgid "Have MATE file manager (Caja) draw the desktop icons."
msgstr "ໃຫ້ເຄື່ອງຈັດການໄຟລ໌ (Caja) ເປັນຜູ້ສະແດງໄອຄອນເທິງເດັສທັອບ."

#: schemas/org.mate.background.gschema.xml.in:28
msgid "Fade the background on change"
msgstr "ຄ່ອຍໆປ່ຽນພາບພື້ນຫຼັງ"

#: schemas/org.mate.background.gschema.xml.in:29
msgid ""
"If set to true, then MATE will change the desktop background with a fading "
"effect."
msgstr "ຫາກຕັ້ງເປັນຈິງ, MATE ຈະປ່ຽນພາບພື້ນຫຼັງເດັສທັອບດ້ວຍເອັບເຟັກແບບຄ່ອຍໆຈາງ."

#: schemas/org.mate.background.gschema.xml.in:33
msgid "Picture Options"
msgstr "ຕົວເລືອກຮູບພາບ"

#: schemas/org.mate.background.gschema.xml.in:34
msgid ""
"Determines how the image set by wallpaper_filename is rendered. Possible "
"values are \"wallpaper\", \"centered\", \"scaled\", \"stretched\", \"zoom\","
" \"spanned\"."
msgstr ""
"ກຳນົດວິທີການສະແດງຮູບພາບພື້ນຫຼັງ. ຄ່າທີ່ເປັນໄປໄດ້ຄື: \"wallpaper\" (ລຽງຕໍ່ກັນ), \"centered\" (ໄ"
"ວ້ທາງກາງ), \"scaled\" (ປັບຂະໜາດ), \"stretched\" (ຢຶດໃຫ້ເຕັມ), \"zoom\" (ຊູມ), "
"\"spanned\" (ຢຶດຂ້າມຈໍ)."

#: schemas/org.mate.background.gschema.xml.in:38
msgid "Picture Filename"
msgstr "ຊື່ໄຟລ໌ຮູບພາບ"

#: schemas/org.mate.background.gschema.xml.in:39
msgid "File to use for the background image."
msgstr "ໄຟລ໌ທີ່ຈະໃຊ້ເປັນຮູບພາບພື້ນຫຼັງ."

#: schemas/org.mate.background.gschema.xml.in:43
msgid "Picture Opacity"
msgstr "ຄວາມທຶບແສງຂອງຮູບ"

#: schemas/org.mate.background.gschema.xml.in:44
msgid "Opacity with which to draw the background picture."
msgstr "ຄ່າຄວາມທຶບແສງທີ່ຈະໃຊ້ສະແດງຮູບພາບພື້ນຫຼັງ."

#: schemas/org.mate.background.gschema.xml.in:48
msgid "Primary Color"
msgstr "ສີຫຼັກ"

#: schemas/org.mate.background.gschema.xml.in:49
msgid "Left or Top color when drawing gradients, or the solid color."
msgstr "ສີດ້ານຊ້າຍ ຫຼື ດ້ານເທິງ ເມື່ອມີການໄລ່ລະດັບສີ, ຫຼື ເປັນສີພື້ນສີດຽວ."

#: schemas/org.mate.background.gschema.xml.in:53
msgid "Secondary Color"
msgstr "ສີຮອງ"

#: schemas/org.mate.background.gschema.xml.in:54
msgid ""
"Right or Bottom color when drawing gradients, not used for solid color."
msgstr "ສີດ້ານຂວາ ຫຼື ດ້ານລຸ່ມ ເມື່ອມີການໄລ່ລະດັບສີ (ບໍ່ໃຊ້ກັບສີພື້ນສີດຽວ)."

#: schemas/org.mate.background.gschema.xml.in:58
msgid "Color Shading Type"
msgstr "ຮູບແບບການໃຫ້ເງົາສີ"

#: schemas/org.mate.background.gschema.xml.in:59
msgid ""
"How to shade the background color. Possible values are \"horizontal-"
"gradient\", \"vertical-gradient\", and \"solid\"."
msgstr ""
"ວິທີການໃຫ້ເງົາສີພື້ນຫຼັງ. ຄ່າທີ່ເປັນໄປໄດ້ຄື: \"horizontal-gradient\" (ໄລ່ສີແນວນອນ), "
"\"vertical-gradient\" (ໄລ່ສີແນວຕັ້ງ) ແລະ \"solid\" (ສີດຽວ)."

#: schemas/org.mate.file-views.gschema.xml:5
msgid "File Icon Theme"
msgstr "ທີມໄອຄອນໄຟລ໌"

#: schemas/org.mate.file-views.gschema.xml:6
msgid "Theme used for displaying file icons."
msgstr "ທີມທີ່ໃຊ້ໃນການສະແດງໄອຄອນໄຟລ໌."

#: schemas/org.mate.interface.gschema.xml:5
msgid "Enable Accessibility"
msgstr "ເປີດໃຊ້ສິ່ງອໍານວຍຄວາມສະດວກ"

#: schemas/org.mate.interface.gschema.xml:6
msgid "Whether Applications should have accessibility support."
msgstr "ກຳນົດວ່າແອັບພລິເຄຊັນຄວນຮອງຮັບສິ່ງອໍານວຍຄວາມສະດວກຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:10
msgid "Enable Animations"
msgstr "ເປີດໃຊ້ພາບເຄື່ອນໄຫວ"

#: schemas/org.mate.interface.gschema.xml:11
msgid ""
"Whether animations should be displayed. Note: This is a global key, it "
"changes the behaviour of the window manager, the panel etc."
msgstr ""
"ກຳນົດວ່າຈະໃຫ້ສະແດງພາບເຄື່ອນໄຫວຫຼືບໍ່. ໝາຍເຫດ: ນີ້ແມ່ນຄ່າທີ່ໃຊ້ຮ່ວມກັນທົ່ວລະບົບ, ມັນຈະປ່ຽນພຶດຕິກຳຂອງເຄື່ອ"
"ງຈັດການໜ້າຕ່າງ, ແຖບພາເນລ ແລະ ອື່ນໆ."

#: schemas/org.mate.interface.gschema.xml:15
msgid "Menus Have Tearoff"
msgstr "ເມນູສາມາດແຍກອອກໄດ້"

#: schemas/org.mate.interface.gschema.xml:16
msgid "Whether menus should have a tearoff."
msgstr "ກຳນົດວ່າເມນູຄວນມີສ່ວນທີ່ສາມາດດຶງແຍກອອກມາໄດ້ຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:20
msgid "Toolbar Style"
msgstr "ຮູບແບບແຖບເຄື່ອງມື"

#: schemas/org.mate.interface.gschema.xml:21
msgid "Toolbar Style. Valid values are \"both\", \"both-horiz\", \"icons\", and \"text\"."
msgstr ""
"ຮູບແບບແຖບເຄື່ອງມື. ຄ່າທີ່ໃຊ້ໄດ້ຄື: \"both\" (ທັງສອງ), \"both-horiz\" (ທັງສອງແນວນອນ), "
"\"icons\" (ໄອຄອນຢ່າງດຽວ) ແລະ \"text\" (ຂໍ້ຄວາມຢ່າງດຽວ)."

#: schemas/org.mate.interface.gschema.xml:25
msgid "Menus Have Icons"
msgstr "ເມນູມີໄອຄອນ"

#: schemas/org.mate.interface.gschema.xml:26
msgid "Whether menus may display an icon next to a menu entry."
msgstr "ກຳນົດວ່າໃນເມນູຄວນສະແດງໄອຄອນຂ້າງລາຍການເມນູຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:30
msgid "Buttons Have Icons"
msgstr "ປຸ່ມມີໄອຄອນ"

#: schemas/org.mate.interface.gschema.xml:31
msgid "Whether buttons may display an icon in addition to the button text."
msgstr "ກຳນົດວ່າຢູ່ປຸ່ມຄວນສະແດງໄອຄອນຄູ່ກັບຂໍ້ຄວາມຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:35
msgid "Menubar Detachable"
msgstr "ແຖບເມນູສາມາດແຍກອອກໄດ້"

#: schemas/org.mate.interface.gschema.xml:36
msgid "Whether the user can detach menubars and move them around."
msgstr "ກຳນົດວ່າຜູ້ໃຊ້ສາມາດດຶງແຖບເມນູແຍກອອກມາ ແລະ ຍ້າຍໄປມາໄດ້ຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:40
msgid "Toolbar Detachable"
msgstr "ແຖບເຄື່ອງມືສາມາດແຍກອອກໄດ້"

#: schemas/org.mate.interface.gschema.xml:41
msgid "Whether the user can detach toolbars and move them around."
msgstr "ກຳນົດວ່າຜູ້ໃຊ້ສາມາດດຶງແຖບເຄື່ອງມືແຍກອອກມາ ແລະ ຍ້າຍໄປມາໄດ້ຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:45
msgid "Toolbar Icon Size"
msgstr "ຂະໜາດໄອຄອນເທິງແຖບເຄື່ອງມື"

#: schemas/org.mate.interface.gschema.xml:46
msgid "Size of icons in toolbars, either \"small-toolbar\" or \"large-toolbar\"."
msgstr ""
"ຂະໜາດຂອງໄອຄອນໃນແຖບເຄື່ອງມື, ເລືອກລະຫວ່າງ \"small-toolbar\" (ແຖບເຄື່ອງມືນ້ອຍ) ຫຼື "
"\"large-toolbar\" (ແຖບເຄື່ອງມືໃຫຍ່)."

#: schemas/org.mate.interface.gschema.xml:50
msgid "Cursor Blink"
msgstr "ເຄີເຊີກະພິບ"

#: schemas/org.mate.interface.gschema.xml:51
msgid "Whether the cursor should blink."
msgstr "ກຳນົດວ່າຈະໃຫ້ເຄີເຊີກະພິບຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:55
msgid "Cursor Blink Time"
msgstr "ຊ່ວງເວລາການກະພິບຂອງເຄີເຊີ"

#: schemas/org.mate.interface.gschema.xml:56
msgid "Length of the cursor blink cycle, in milliseconds."
msgstr "ໄລຍະເວລາໃນການກະພິບໜຶ່ງຮອບ ເປັນມິນລິວິນາທີ."

#: schemas/org.mate.interface.gschema.xml:60
msgid "Icon Theme"
msgstr "ທີມໄອຄອນ"

#: schemas/org.mate.interface.gschema.xml:61
msgid "Icon theme to use for the panel, Caja etc."
msgstr "ທີມໄອຄອນທີ່ຈະໃຊ້ສຳລັບແຖບພາເນລ, Caja ແລະ ອື່ນໆ."

#: schemas/org.mate.interface.gschema.xml:65
#: schemas/org.mate.interface.gschema.xml:70
msgid "Gtk+ Theme"
msgstr "ທີມ Gtk+"

#: schemas/org.mate.interface.gschema.xml:66
#: schemas/org.mate.interface.gschema.xml:71
msgid "Basename of the default theme used by gtk+."
msgstr "ຊື່ພື້ນຖານຂອງທີມເລີ່ມຕົ້ນທີ່ໃຊ້ໂດຍ gtk+."

#: schemas/org.mate.interface.gschema.xml:75
msgid "List of symbolic names and color equivalents"
msgstr "ລາຍຊື່ຂອງຊື່ສັນຍະລັກ ແລະ ສີທີ່ກົງກັນ"

#: schemas/org.mate.interface.gschema.xml:76
msgid ""
"A '\\n' separated list of \"name:color\" as defined by the 'gtk-color-"
"scheme' setting"
msgstr ""
"ລາຍຊື່ທີ່ແຍກດ້ວຍ '\\n' ຂອງ \"name:color\" ຕາມທີ່ກຳນົດໃນການຕັ້ງຄ່າ 'gtk-color-scheme'"

#: schemas/org.mate.interface.gschema.xml:80
msgid "Default font"
msgstr "ຕົວອັກສອນເລີ່ມຕົ້ນ"

#: schemas/org.mate.interface.gschema.xml:81
msgid "Name of the default font used by gtk+."
msgstr "ຊື່ຂອງຕົວອັກສອນເລີ່ມຕົ້ນທີ່ໃຊ້ໂດຍ gtk+."

#: schemas/org.mate.interface.gschema.xml:85
msgid "GTK IM Preedit Style"
msgstr "ຮູບແບບ GTK IM Preedit"

#: schemas/org.mate.interface.gschema.xml:86
msgid "Name of the GTK+ input method Preedit Style used by gtk+."
msgstr "ຊື່ຂອງຮູບແບບ Preedit ສຳລັບວິທີການປ້ອນຂໍ້ມູນ GTK+ ທີ່ໃຊ້ໂດຍ gtk+."

#: schemas/org.mate.interface.gschema.xml:90
msgid "GTK IM Status Style"
msgstr "ຮູບແບບສະຖານະ GTK IM"

#: schemas/org.mate.interface.gschema.xml:91
msgid "Name of the GTK+ input method Status Style used by gtk+."
msgstr "ຊື່ຂອງຮູບແບບສະຖານະສຳລັບວິທີການປ້ອນຂໍ້ມູນ GTK+ ທີ່ໃຊ້ໂດຍ gtk+."

#: schemas/org.mate.interface.gschema.xml:95
msgid "GTK IM Module"
msgstr "ໂມດູນ GTK IM"

#: schemas/org.mate.interface.gschema.xml:96
msgid "Name of the input method module used by GTK+."
msgstr "ຊື່ຂອງໂມດູນວິທີການປ້ອນຂໍ້ມູນທີ່ໃຊ້ໂດຍ GTK+."

#: schemas/org.mate.interface.gschema.xml:100
msgid "Use GTK3 header bar"
msgstr "ໃຊ້ແຖບຫົວເລື່ອງ GTK3"

#: schemas/org.mate.interface.gschema.xml:101
msgid ""
"Whether builtin GTK+ dialogs such as the file chooser, the color chooser or "
"the font chooser will use a header bar at the top to show action widgets, or"
" an action area at the bottom. This setting does not affect custom dialogs "
"using GtkDialog directly, or message dialogs."
msgstr ""
"ກຳນົດວ່າໜ້າຕ່າງມາດຕະຖານຂອງ GTK+ ເຊັ່ນ: ເຄື່ອງເລືອກໄຟລ໌, ເຄື່ອງເລືອກສີ ຫຼື ເຄື່ອງເລືອກຕົວອັກສອນ ຈະໃ"
"ຊ້ແຖບຫົວເລື່ອງຢູ່ດ້ານເທິງເພື່ອສະແດງປຸ່ມກົດ ຫຼື ໃຊ້ພື້ນທີ່ດ້ານລຸ່ມ. ການຕັ້ງຄ່ານີ້ບໍ່ມີຜົນກັບໜ້າຕ່າງທີ່ສ້າງຂຶ້ນເອງ ຫຼື ໜ້າ"
"ຕ່າງແຈ້ງເຕືອນ."

#: schemas/org.mate.interface.gschema.xml:105
msgid "Use GTK3 overlay scrolling"
msgstr "ໃຊ້ການເລື່ອນແບບ Overlay ຂອງ GTK3"

#: schemas/org.mate.interface.gschema.xml:106
msgid ""
"Whether built-in GTK+ scrolled windows will use overlay scrolling. Overlay "
"scrolling hides and reduces the size of the scrollbar until it gets focus."
msgstr ""
"ກຳນົດວ່າໜ້າຕ່າງທີ່ມີແຖບເລື່ອນຂອງ GTK+ ຈະໃຊ້ການເລື່ອນແບບ Overlay ຫຼືບໍ່. ການເລື່ອນແບບ Overlay ຈະ"
"ເຊື່ອງ ແລະ ຫຼຸດຂະໜາດແຖບເລື່ອນລົງຈົນກວ່າຈະມີການໃຊ້ງານ."

#: schemas/org.mate.interface.gschema.xml:110
msgid "Enable Gtk toolkit-wide animations"
msgstr "ເປີດໃຊ້ພາບເຄື່ອນໄຫວໃນລະດັບຊຸດເຄື່ອງມື Gtk"

#: schemas/org.mate.interface.gschema.xml:111
msgid "Whether to enable toolkit-wide animations."
msgstr "ກຳນົດວ່າຈະເປີດໃຊ້ພາບເຄື່ອນໄຫວໃນທຸກໆສ່ວນຂອງຊຸດເຄື່ອງມືຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:115
msgid "Document font"
msgstr "ຕົວອັກສອນເອກະສານ"

#: schemas/org.mate.interface.gschema.xml:116
msgid "Name of the default font used for reading documents."
msgstr "ຊື່ຂອງຕົວອັກສອນເລີ່ມຕົ້ນທີ່ໃຊ້ສຳລັບການອ່ານເອກະສານ."

#: schemas/org.mate.interface.gschema.xml:120
msgid "Monospace font"
msgstr "ຕົວອັກສອນແບບ Monospace"

#: schemas/org.mate.interface.gschema.xml:121
msgid ""
"Name of a monospaced (fixed-width) font for use in locations like terminals."
msgstr ""
"ຊື່ຂອງຕົວອັກສອນແບບ Monospace (ຄວາມກວ້າງຄົງທີ່) ສຳລັບໃຊ້ໃນບ່ອນຕ່າງໆ ເຊັ່ນ ເທີມີນໍ."

#: schemas/org.mate.interface.gschema.xml:125
msgid "Use Custom Font"
msgstr "ໃຊ້ຕົວອັກສອນທີ່ກຳນົດເອງ"

#: schemas/org.mate.interface.gschema.xml:126
msgid "Whether to use a custom font in gtk+ applications."
msgstr "ກຳນົດວ່າຈະໃຊ້ຕົວອັກສອນທີ່ກຳນົດເອງໃນແອັບພລິເຄຊັນ gtk+ ຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:130
msgid "Status Bar on Right"
msgstr "ແຖບສະຖານະຢູ່ດ້ານຂວາ"

#: schemas/org.mate.interface.gschema.xml:131
msgid "Whether to display a status bar meter on the right."
msgstr "ກຳນົດວ່າຈະສະແດງເຄື່ອງວັດແທກໃນແຖບສະຖານະຢູ່ດ້ານຂວາຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:135
msgid "Module for GtkFileChooser"
msgstr "ໂມດູນສຳລັບ GtkFileChooser"

#: schemas/org.mate.interface.gschema.xml:136
msgid ""
"Module to use as the filesystem model for the GtkFileChooser widget. "
"Possible values are \"gio\" and \"gtk+\"."
msgstr ""
"ໂມດູນທີ່ຈະໃຊ້ເປັນຮູບແບບລະບົບໄຟລ໌ສຳລັບ GtkFileChooser. ຄ່າທີ່ເປັນໄປໄດ້ຄື \"gio\" ແລະ "
"\"gtk+\"."

#: schemas/org.mate.interface.gschema.xml:140
msgid "Menubar accelerator"
msgstr "ປຸ່ມລັດແຖບເມນູ"

#: schemas/org.mate.interface.gschema.xml:141
msgid "Keyboard shortcut to open the menu bars."
msgstr "ປຸ່ມລັດຄີບອດເພື່ອເປີດແຖບເມນູ."

#: schemas/org.mate.interface.gschema.xml:145
msgid "Show the 'Input Methods' menu"
msgstr "ສະແດງເມນູ 'ວິທີການປ້ອນຂໍ້ມູນ'"

#: schemas/org.mate.interface.gschema.xml:146
msgid ""
"Whether the context menus of entries and text views should offer to change "
"the input method."
msgstr ""
"ກຳນົດວ່າເມນູເມື່ອຄລິກຂວາໃນຊ່ອງປ້ອນຂໍ້ມູນ ແລະ ບ່ອນສະແດງຂໍ້ຄວາມ ຄວນມີຕົວເລືອກປ່ຽນວິທີການປ້ອນຂໍ້ມູນຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:150
msgid "Show the 'Unicode Control Character' menu"
msgstr "ສະແດງເມນູ 'ຕົວອັກສອນຄວບຄຸມຢູນິໂຄ້ດ'"

#: schemas/org.mate.interface.gschema.xml:151
msgid ""
"Whether the context menus of entries and text views should offer to insert "
"control characters."
msgstr ""
"ກຳນົດວ່າເມນູເມື່ອຄລິກຂວາໃນຊ່ອງປ້ອນຂໍ້ມູນ ແລະ ບ່ອນສະແດງຂໍ້ຄວາມ ຄວນມີຕົວເລືອກແຊກຕົວອັກສອນຄວບຄຸມຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:155
msgid "Titlebar layout of GTK3 client-side decorated windows"
msgstr "ການຈັດວາງແຖບຫົວເລື່ອງຂອງໜ້າຕ່າງທີ່ຕົກແຕ່ງໂດຍຝັ່ງລູກຂ່າຍ GTK3"

#: schemas/org.mate.interface.gschema.xml:156
msgid ""
"This setting determines which buttons should be put in the titlebar of "
"client-side decorated windows, and whether they should be placed at the left"
" of right. See "
"https://developer.gnome.org/gtk3/stable/GtkSettings.html#GtkSettings--gtk-"
"decoration-layout."
msgstr ""
"ການຕັ້ງຄ່ານີ້ກຳນົດວ່າປຸ່ມໃດແດ່ທີ່ຈະຖືກວາງໄວ້ໃນແຖບຫົວເລື່ອງ ແລະ ຈະວາງໄວ້ທາງຊ້າຍ ຫຼື ທາງຂວາ."

#: schemas/org.mate.interface.gschema.xml:160
msgid "Use a global menubar for displaying application menus"
msgstr "ໃຊ້ແຖບເມນູລວມເພື່ອສະແດງເມນູຂອງແອັບພລິເຄຊັນ"

#: schemas/org.mate.interface.gschema.xml:161
msgid ""
"This setting determines where application menu will be displayed - in a "
"window or on a panel with MenuModel protocol. See "
"https://developer.gnome.org/gtk3/stable/GtkSettings.html#GtkSettings--gtk-"
"shell-shows-app-menu."
msgstr ""
"ການຕັ້ງຄ່ານີ້ກຳນົດວ່າເມນູແອັບພລິເຄຊັນຈະຖືກສະແດງຢູ່ໃສ - ຢູ່ໃນໜ້າຕ່າງ ຫຼື ຢູ່ເທິງພາເນລ."

#: schemas/org.mate.interface.gschema.xml:165
msgid "Use a global menubar for displaying window menubars"
msgstr "ໃຊ້ແຖບເມນູລວມເພື່ອສະແດງແຖບເມນູຂອງໜ້າຕ່າງ"

#: schemas/org.mate.interface.gschema.xml:166
msgid ""
"This setting determines where window menubars will be displayed - in a "
"window or on a panel with MenuModel protocol. See "
"https://developer.gnome.org/gtk3/stable/GtkSettings.html#GtkSettings--gtk-"
"shell-shows-menubar."
msgstr ""
"ການຕັ້ງຄ່ານີ້ກຳນົດວ່າແຖບເມນູຂອງໜ້າຕ່າງຈະຖືກສະແດງຢູ່ໃສ - ຢູ່ໃນໜ້າຕ່າງ ຫຼື ຢູ່ເທິງພາເນລ."

#: schemas/org.mate.interface.gschema.xml:170
msgid "Only show mnemonics on when the Alt key is pressed"
msgstr "ສະແດງຕົວອັກສອນຊ່ວຍຈຳເມື່ອກົດປຸ່ມ Alt ເທົ່ານັ້ນ"

#: schemas/org.mate.interface.gschema.xml:171
msgid ""
"Whether mnemonics should be automatically shown and hidden when the user "
"presses the Alt key."
msgstr ""
"ກຳນົດວ່າຈະໃຫ້ສະແດງ ຫຼື ເຊື່ອງຕົວອັກສອນຊ່ວຍຈຳໂດຍອັດຕະໂນມັດເມື່ອຜູ້ໃຊ້ກົດປຸ່ມ Alt ຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:176
msgid "Window Scaling Factor"
msgstr "ອັດຕາສ່ວນການຂະຫຍາຍໜ້າຕ່າງ"

#: schemas/org.mate.interface.gschema.xml:177
msgid ""
"This controls the GTK scale factor that maps from window coordinates to the "
"actual device pixels. On traditional systems this is 1, but on very high "
"density displays (e.g. HiDPI, Retina) this can be a higher value (often 2). "
"Set to 0 to auto-detect."
msgstr ""
"ຄວບຄຸມອັດຕາສ່ວນການຂະຫຍາຍຂອງ GTK. ສຳລັບຈໍພາບທີ່ມີຄວາມລະອຽດສູງ (ເຊັ່ນ HiDPI) ອາດຕັ້ງເປັນ 2. ຕັ້"
"ງເປັນ 0 ເພື່ອກວດສອບອັດຕະໂນມັດ."

#: schemas/org.mate.interface.gschema.xml:181
msgid "Scaling Factor for QT appllications"
msgstr "ອັດຕາສ່ວນການຂະຫຍາຍສຳລັບແອັບພລິເຄຊັນ QT"

#: schemas/org.mate.interface.gschema.xml:182
msgid ""
"This setting determines whether MATE controls the scale factor for QT "
"applications. Enable to synchronize with the GTK scale factor when "
"initializing the session, disable to control this value elsewhere. Requires "
"restarting your session."
msgstr "ກຳນົດວ່າຈະໃຫ້ MATE ຄວບຄຸມອັດຕາສ່ວນການຂະຫຍາຍສຳລັບແອັບ QT ຫຼືບໍ່."

#: schemas/org.mate.interface.gschema.xml:186
msgid "Enable the primary paste selection"
msgstr "ເປີດໃຊ້ການວາງຈາກການເລືອກຫຼັກ"

#: schemas/org.mate.interface.gschema.xml:187
msgid ""
"If true, gtk+ uses the primary paste selection, usually triggered by a "
"middle mouse button click."
msgstr ""
"ຫາກຕັ້ງເປັນຈິງ, gtk+ ຈະໃຊ້ການວາງຂໍ້ມູນຈາກການເລືອກຫຼັກ ເຊິ່ງປົກກະຕິແລ້ວຈະໃຊ້ປຸ່ມກາງຂອງເມົາສ໌."

#: schemas/org.mate.lockdown.gschema.xml:5
msgid "Disable command line"
msgstr "ປິດການໃຊ້ງານຄຳສັ່ງ (Command line)"

#: schemas/org.mate.lockdown.gschema.xml:6
msgid ""
"Prevent the user from accessing the terminal or specifying a command line to"
" be executed. For example, this would disable access to the panel's \"Run "
"Application\" dialog."
msgstr ""
"ປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ເຂົ້າເຖິງເທີມີນໍ ຫຼື ລະບຸຄຳສັ່ງທີ່ຈະປະມວນຜົນ. ຕົວຢ່າງ: ມັນຈະປິດການເຂົ້າເຖິງໜ້າຕ່າງ \"Run "
"Application\" ໃນພາເນລ."

#: schemas/org.mate.lockdown.gschema.xml:10
msgid "Disable saving files to disk"
msgstr "ປິດການບັນທຶກໄຟລ໌ລົງດິສກ໌"

#: schemas/org.mate.lockdown.gschema.xml:11
msgid ""
"Prevent the user from saving files to disk. For example, this would disable "
"access to all applications' \"Save as\" dialogs."
msgstr ""
"ປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ບັນທຶກໄຟລ໌ລົງໃນດິສກ໌. ຕົວຢ່າງ: ມັນຈະປິດການເຂົ້າເຖິງໜ້າຕ່າງ \"Save as\" ຂອງທຸກແອັບພລິ"
"ເຄຊັນ."

#: schemas/org.mate.lockdown.gschema.xml:15
msgid "Disable printing"
msgstr "ປິດການພິມ"

#: schemas/org.mate.lockdown.gschema.xml:16
msgid ""
"Prevent the user from printing. For example, this would disable access to "
"all applications' \"Print\" dialogs."
msgstr ""
"ປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ສັ່ງພິມ. ຕົວຢ່າງ: ມັນຈະປິດການເຂົ້າເຖິງໜ້າຕ່າງ \"Print\" ຂອງທຸກແອັບພລິເຄຊັນ."

#: schemas/org.mate.lockdown.gschema.xml:20
msgid "Disable print setup"
msgstr "ປິດການຕັ້ງຄ່າການພິມ"

#: schemas/org.mate.lockdown.gschema.xml:21
msgid ""
"Prevent the user from modifying print settings. For example, this would "
"disable access to all applications' \"Print Setup\" dialogs."
msgstr ""
"ປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ແກ້ໄຂການຕັ້ງຄ່າການພິມ. ຕົວຢ່າງ: ມັນຈະປິດການເຂົ້າເຖິງໜ້າຕ່າງ \"Print Setup\" ຂອງທຸ"
"ກແອັບພລິເຄຊັນ."

#: schemas/org.mate.lockdown.gschema.xml:25
msgid "Disable user switching"
msgstr "ປິດການສະຫຼັບຜູ້ໃຊ້"

#: schemas/org.mate.lockdown.gschema.xml:26
msgid ""
"Prevent the user from switching to another account while his session is "
"active."
msgstr "ປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ສະຫຼັບໄປໃຊ້ບັນຊີອື່ນໃນຂະນະທີ່ຍັງມີການໃຊ້ງານຢູ່."

#: schemas/org.mate.lockdown.gschema.xml:30
msgid "Disable lock screen"
msgstr "ປິດການລັອກໜ້າຈໍ"

#: schemas/org.mate.lockdown.gschema.xml:31
msgid "Prevent the user from locking the screen."
msgstr "ປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ລັອກໜ້າຈໍ."

#: schemas/org.mate.lockdown.gschema.xml:35
msgid "Disable URL and MIME type handlers"
msgstr "ປິດລະບົບຈັດການ URL ແລະ MIME type"

#: schemas/org.mate.lockdown.gschema.xml:36
msgid "Prevent running any URL or MIME type handler applications."
msgstr "ປ້ອງກັນບໍ່ໃຫ້ເປີດແອັບພລິເຄຊັນທີ່ຈັດການ URL ຫຼື MIME type ໃດໆ."

#: schemas/org.mate.lockdown.gschema.xml:40
msgid "Disable theme settings"
msgstr "ປິດການຕັ້ງຄ່າທີມ"

#: schemas/org.mate.lockdown.gschema.xml:41
msgid "Prevent the user from changing theme settings."
msgstr "ປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ປ່ຽນການຕັ້ງຄ່າທີມ."

#: schemas/org.mate.lockdown.gschema.xml:45
msgid "Disable log out"
msgstr "ປິດການອອກຈາກລະບົບ"

#: schemas/org.mate.lockdown.gschema.xml:46
msgid "Prevent the user from logging out."
msgstr "ປ້ອງກັນບໍ່ໃຫ້ຜູ້ໃຊ້ກົດອອກຈາກລະບົບ."

#: schemas/org.mate.sound.gschema.xml:5
msgid "Default mixer device"
msgstr "ອຸປະກອນມິກເຊີເລີ່ມຕົ້ນ"

#: schemas/org.mate.sound.gschema.xml:6
msgid "The default mixer device used by the multimedia key bindings."
msgstr "ອຸປະກອນມິກເຊີເລີ່ມຕົ້ນທີ່ຈະໃຊ້ກັບປຸ່ມລັດມັນຕິມີເດຍ."

#: schemas/org.mate.sound.gschema.xml:10
msgid "Default mixer tracks"
msgstr "ແທຣັກມິກເຊີເລີ່ມຕົ້ນ"

#: schemas/org.mate.sound.gschema.xml:11
msgid "The default mixer tracks used by the multimedia key bindings."
msgstr "ແທຣັກມິກເຊີເລີ່ມຕົ້ນທີ່ຈະໃຊ້ກັບປຸ່ມລັດມັນຕິມີເດຍ."

#: schemas/org.mate.sound.gschema.xml:15
msgid "Enable ESD"
msgstr "ເປີດໃຊ້ ESD"

#: schemas/org.mate.sound.gschema.xml:16
msgid "Enable sound server startup."
msgstr "ເປີດໃຊ້ການເລີ່ມຕົ້ນລະບົບເຊີບເວີສຽງ."

#: schemas/org.mate.sound.gschema.xml:20
msgid "Sounds for events"
msgstr "ສຽງສຳລັບເຫດການຕ່າງໆ"

#: schemas/org.mate.sound.gschema.xml:21
msgid "Whether to play sounds on user events."
msgstr "ກຳນົດວ່າຈະໃຫ້ຫຼິ້ນສຽງເມື່ອເກີດເຫດການຈາກຜູ້ໃຊ້ຫຼືບໍ່."

#: schemas/org.mate.sound.gschema.xml:25
msgid "Sound theme name"
msgstr "ຊື່ທີມສຽງ"

#: schemas/org.mate.sound.gschema.xml:26
msgid "The XDG sound theme to use for event sounds."
msgstr "ທີມສຽງ XDG ທີ່ຈະໃຊ້ສຳລັບສຽງເຫດການຕ່າງໆ."

#: schemas/org.mate.sound.gschema.xml:30
msgid "Input feedback sounds"
msgstr "ສຽງຕອບສະໜອງການປ້ອນຂໍ້ມູນ"

#: schemas/org.mate.sound.gschema.xml:31
msgid "Whether to play sounds on input events."
msgstr "ກຳນົດວ່າຈະໃຫ້ຫຼິ້ນສຽງເມື່ອມີການປ້ອນຂໍ້ມູນຫຼືບໍ່."

#: schemas/org.mate.sound.gschema.xml:35
msgid "Permit the output volume to exceed 100%"
msgstr "ອະນຸຍາດໃຫ້ລະດັບສຽງດັງເກີນ 100%"

#: schemas/org.mate.sound.gschema.xml:36
msgid ""
"If this is set to TRUE, the user will be allowed to set the output / speaker"
" volume to above 100%. By setting the output volume above 100%, the sound "
"server will amplify the audio above what the audio hardware can do cleanly. "
"This can lead to audio quality degradation, but may be useful for listening "
"to extremely quiet audio recordings, where the recording would otherwise be "
"completely useless."
msgstr ""
"ຫາກຕັ້ງເປັນຈິງ, ຜູ້ໃຊ້ຈະສາມາດປັບສຽງໃຫ້ດັງເກີນ 100% ໄດ້. ນີ້ອາດຈະເຮັດໃຫ້ຄຸນນະພາບສຽງຫຼຸດລົງ ແຕ່ຈະມີປະ"
"ໂຫຍດໃນການຟັງສຽງທີ່ບັນທຶກມາເບົາຫຼາຍໆ."

#: schemas/org.mate.thumbnail-cache.gschema.xml:6
msgid ""
"Maximum age for thumbnails in the cache, in days. Set to -1 to disable "
"cleaning."
msgstr "ອາຍຸສູງສຸດຂອງຮູບຕົວຢ່າງໃນແຄຊ໌ (ເປັນມື້). ຕັ້ງເປັນ -1 ເພື່ອປິດການລຶບ."

#: schemas/org.mate.thumbnail-cache.gschema.xml:10
msgid ""
"Maximum size of the thumbnail cache, in megabytes. Set to -1 to disable "
"cleaning."
msgstr ""
"ຂະໜາດສູງສຸດຂອງແຄຊ໌ຮູບຕົວຢ່າງ (ເປັນເມກາໄບຕ໌). ຕັ້ງເປັນ -1 ເພື່ອປິດການລຶບ."

#: schemas/org.mate.thumbnailers.gschema.xml:5
msgid "Disable all external thumbnailers"
msgstr "ປິດລະບົບສ້າງຮູບຕົວຢ່າງພາຍນອກທັງໝົດ"

#: schemas/org.mate.thumbnailers.gschema.xml:6
msgid ""
"Set to true to disable all external thumbnailer programs, independent on "
"whether they are independently disabled/enabled."
msgstr "ຫາກຕັ້ງເປັນຈິງ ຈະປິດໂປຣແກຣມສ້າງຮູບຕົວຢ່າງພາຍນອກທັງໝົດ."

#: schemas/org.mate.thumbnailers.gschema.xml:10
msgid ""
"List of mime-types for which external thumbnailer programs will be disabled"
msgstr "ລາຍຊື່ mime-type ທີ່ຈະບໍ່ໃຫ້ໃຊ້ໂປຣແກຣມສ້າງຮູບຕົວຢ່າງພາຍນອກ"

#: schemas/org.mate.thumbnailers.gschema.xml:11
msgid ""
"Thumbnails will not be created for files whose mime-type is contained in the"
" list."
msgstr "ຈະບໍ່ມີການສ້າງຮູບຕົວຢ່າງສຳລັບໄຟລ໌ທີ່ມີ mime-type ຢູ່ໃນລາຍຊື່ນີ້."

#: schemas/org.mate.typing-break.gschema.xml:5
msgid "Type time"
msgstr "ເວລາໃນການພິມ"

#: schemas/org.mate.typing-break.gschema.xml:6
msgid "Number of minutes of typing time before break mode starts."
msgstr "ຈຳນວນນາທີທີ່ພິມ ກ່ອນທີ່ຈະເລີ່ມໂໝດພັກການພິມ."

#: schemas/org.mate.typing-break.gschema.xml:10
msgid "Break time"
msgstr "ເວລາພັກ"

#: schemas/org.mate.typing-break.gschema.xml:11
msgid "Number of minutes that the typing break should last."
msgstr "ຈຳນວນນາທີທີ່ຈະໃຫ້ພັກການພິມ."

#: schemas/org.mate.typing-break.gschema.xml:15
msgid "Allow postponing of breaks"
msgstr "ອະນຸຍາດໃຫ້ເລື່ອນເວລາພັກໄດ້"

#: schemas/org.mate.typing-break.gschema.xml:16
msgid "Whether or not the typing break screen can be postponed."
msgstr "ກຳນົດວ່າຈະໃຫ້ສາມາດເລື່ອນເວລາພັກການພິມອອກໄປໄດ້ຫຼືບໍ່."

#: schemas/org.mate.typing-break.gschema.xml:20
msgid "Whether or not keyboard locking is enabled"
msgstr "ກຳນົດວ່າຈະໃຫ້ມີການລັອກຄີບອດຫຼືບໍ່"

#: schemas/org.mate.typing-break.gschema.xml:21
msgid "Whether or not keyboard locking is enabled."
msgstr "ກຳນົດວ່າຈະໃຫ້ມີການລັອກຄີບອດຫຼືບໍ່."

#: tools/mate-color-select.c:63 tools/mate-color-select.desktop.in:3
msgid "MATE Color Selection"
msgstr "ການເລືອກສີຂອງ MATE"

#: tools/mate-color-select.c:70
msgid "_Copy"
msgstr "_ສຳເນົາ"

