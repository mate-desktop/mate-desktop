#. Keep this string in sync with mate-control-center/capplets/display/xrandr-
#. capplet.c:get_display_name()
#. Translators:  this is the feature where what you see on your laptop's
#. * screen is the same as your external monitor.  Here, "Mirror" is being
#. * used as an adjective, not as a verb.  For example, the Spanish
#. * translation could be "Pantallas en Espejo", *not* "Espejar Pantallas".
#: libmate-desktop/mate-rr-labeler.c:406
msgid "Mirror Screens"
msgstr "ສະແດງຜົນແບບແວ່ນເງົາ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:25
msgid "minimum interval in milliseconds"
msgstr "ຊ່ວງເວລາຕ່ຳສຸດເປັນມິນລິວິນາທີ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:26
msgid "Ignore multiple presses of the _same_ key within @delay milliseconds."
msgstr "ບໍ່ສົນໃຈການກົດປຸ່ມ _ດຽວກັນ_ ຫຼາຍຄັ້ງພາຍໃນ @delay ມິນລິວິນາທີ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:36
msgid "Pixels per seconds"
msgstr "ພິກເຊວຕໍ່ວິນາທີ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:37
msgid "How many pixels per second to move at the maximum speed."
msgstr "ຈຳນວນພິກເຊວຕໍ່ວິນາທີທີ່ຈະເຄື່ອນທີ່ດ້ວຍຄວາມໄວສູງສຸດ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:41
msgid "How long to accelerate in milliseconds"
msgstr "ໄລຍະເວລາໃນການເລັ່ງຄວາມໄວເປັນມິນລິວິນາທີ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:42
msgid "How many milliseconds it takes to go from 0 to maximum speed."
msgstr "ຈຳນວນມິນລິວິນາທີທີ່ໃຊ້ເພື່ອເລັ່ງຈາກ 0 ໄປຫາຄວາມໄວສູງສຸດ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:46
msgid "Initial delay in milliseconds"
msgstr "ໄລຍະເວລາລໍຖ້າເລີ່ມຕົ້ນເປັນມິນລິວິນາທີ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:47
msgid ""
"How many milliseconds to wait before mouse movement keys start to operate."
msgstr ""
"ຈຳນວນມິນລິວິນາທີທີ່ຈະລໍຖ້າ ກ່ອນທີ່ປຸ່ມຄວບຄຸມການເຄື່ອນທີ່ຂອງເມົາສ໌ຈະເລີ່ມທຳງານ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:54
msgid "Minimum interval in milliseconds"
msgstr "ຊ່ວງເວລາຕ່ຳສຸດເປັນມິນລິວິນາທີ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:55
msgid ""
"Do not accept a key as being pressed unless held for @delay milliseconds."
msgstr "ຈະບໍ່ຍອມຮັບວ່າປຸ່ມຖືກກົດ ນອກຈາກຈະກົດຄ້າງໄວ້ດົນກວ່າ @delay ມິນລິວິນາທີ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:71
msgid ""
"Latch modifiers when pressed twice in a row until the same modifier is "
"pressed again."
msgstr ""
"ຄ້າງປຸ່ມປ່ຽນສະຖານະ (modifier) ເມື່ອກົດສອງຄັ້ງຕິດຕໍ່ກັນ ຈົນກວ່າຈະກົດປຸ່ມເດີມຊ້ຳອີກຄັ້ງ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:75
msgid "Disable if two keys are pressed at the same time."
msgstr "ປິດການໃຊ້ງານ ຫາກມີການກົດສອງປຸ່ມພ້ອມກັນ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:79
msgid "Beep when a modifier is pressed."
msgstr "ສົ່ງສຽງເຕືອນເມື່ອປຸ່ມປ່ຽນສະຖານະຖືກກົດ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:86
msgid "Beep when a key is pressed while CapsLock is active."
msgstr "ສົ່ງສຽງເຕືອນເມື່ອກົດປຸ່ມໃນຂະນະທີ່ເປີດ CapsLock ຢູ່."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:91
msgid "Beep count when enabling a modifier"
msgstr "ຈຳນວນສຽງເຕືອນເມື່ອເປີດໃຊ້ປຸ່ມປ່ຽນສະຖານະ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:92
msgid ""
"Number of beeps to emit when enabling a modifier while togglekeys are "
"enabled. Only works with the 'internal' backend."
msgstr ""
"ຈຳນວນສຽງເຕືອນທີ່ຈະສົ່ງອອກມາເມື່ອເປີດໃຊ້ປຸ່ມປ່ຽນສະຖານະ ໃນຂະນະທີ່ເປີດໃຊ້ togglekeys. ໃຊ້ໄດ້ກັບລະບົ"
"ບ 'internal' ເທົ່ານັ້ນ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:97
msgid "Delay between beeps when enabling a modifier"
msgstr "ໄລຍະເວລາລະຫວ່າງສຽງເຕືອນເມື່ອເປີດໃຊ້ປຸ່ມປ່ຽນສະຖານະ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:98
msgid ""
"Delay in milliseconds between two beeps when enabling a modifier while "
"togglekeys are enabled. Only works with the 'internal' backend."
msgstr ""
"ໄລຍະເວລາເປັນມິນລິວິນາທີລະຫວ່າງສຽງເຕືອນສອງຄັ້ງ ເມື່ອເປີດໃຊ້ປຸ່ມປ່ຽນສະຖານະໃນຂະນະທີ່ເປີດໃຊ້ "
"togglekeys. ໃຊ້ໄດ້ກັບລະບົບ 'internal' ເທົ່ານັ້ນ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:103
msgid "Beep count when disabling a modifier"
msgstr "ຈຳນວນສຽງເຕືອນເມື່ອປິດການໃຊ້ປຸ່ມປ່ຽນສະຖານະ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:104
msgid ""
"Number of beeps to emit when disabling a modifier while togglekeys are "
"enabled. Only works with the 'internal' backend."
msgstr ""
"ຈຳນວນສຽງເຕືອນທີ່ຈະສົ່ງອອກມາເມື່ອປິດການໃຊ້ປຸ່ມປ່ຽນສະຖານະ ໃນຂະນະທີ່ເປີດໃຊ້ togglekeys. ໃຊ້ໄດ້ກັບລະ"
"ບົບ 'internal' ເທົ່ານັ້ນ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:109
msgid "Delay between beeps when disabling a modifier"
msgstr "ໄລຍະເວລາລະຫວ່າງສຽງເຕືອນເມື່ອປິດການໃຊ້ປຸ່ມປ່ຽນສະຖານະ"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:110
msgid ""
"Delay in milliseconds between two beeps when disabling a modifier while "
"togglekeys are enabled. Only works with the 'internal' backend."
msgstr ""
"ໄລຍະເວລາເປັນມິນລິວິນາທີລະຫວ່າງສຽງເຕືອນສອງຄັ້ງ ເມື່ອປິດການໃຊ້ປຸ່ມປ່ຽນສະຖານະໃນຂະນະທີ່ເປີດໃຊ້ "
"togglekeys. ໃຊ້ໄດ້ກັບລະບົບ 'internal' ເທົ່ານັ້ນ."

#: schemas/org.mate.accessibility-keyboard.gschema.xml:114
msgid "Implementation to use when togglekeys are enabled"
msgstr "ລະບົບທີ່ຈະໃຊ້ເມື່ອເປີດໃຊ້ togglekeys"

#: schemas/org.mate.accessibility-keyboard.gschema.xml:115
msgid ""
"Selects the backend to use to provide the togglekeys feature. Valid values "
"include 'xkb' (the stock X implementation) and 'internal' (a MATE-specific "
"and more configurable implementation)."
msgstr ""
"ເລືອກລະບົບເບື້ອງຫຼັງທີ່ຈະໃຊ້ສຳລັບຟີເຈີ togglekeys. ຄ່າທີ່ໃຊ້ໄດ້ລວມມີ 'xkb' (ລະບົບມາດຕະຖານຂອງ X) "
"ແລະ 'internal' (ລະບົບສະເພາະຂອງ MATE ທີ່ຕັ້ງຄ່າໄດ້ຫຼາຍກວ່າ)."

#: schemas/org.mate.accessibility-startup.gschema.xml:5
msgid "Startup Assistive Technology Applications"
msgstr "ເປີດແອັບພລິເຄຊັນເຕັກໂນໂລຊີຊ່ວຍເຫຼືອເມື່ອເລີ່ມລະບົບ"

#: schemas/org.mate.accessibility-startup.gschema.xml:6
msgid ""
"List of assistive technology applications to start when logging into the "
"MATE desktop."
msgstr ""
"ລາຍຊື່ແອັບພລິເຄຊັນເຕັກໂນໂລຊີຊ່ວຍເຫຼືອທີ່ຈະໃຫ້ເລີ່ມທຳງານເມື່ອເຂົ້າສູ່ລະບົບ MATE."

#: schemas/org.mate.applications-at-mobility.gschema.xml:5
msgid "Preferred Mobility assistive technology application"
msgstr "ແອັບພລິເຄຊັນເຕັກໂນໂລຊີຊ່ວຍເຫຼືອດ້ານການເຄື່ອນໄຫວທີ່ຕ້ອງການ"

#: schemas/org.mate.applications-at-mobility.gschema.xml:6
msgid ""
"Preferred Mobility assistive technology application to be used for login, "
"menu, or command line."
msgstr ""
"ແອັບພລິເຄຊັນເຕັກໂນໂລຊີຊ່ວຍເຫຼືອດ້ານການເຄື່ອນໄຫວທີ່ເລືອກໃຊ້ສຳລັບການເຂົ້າລະບົບ, ເມນູ ຫຼື ຄຳສັ່ງ."

#: schemas/org.mate.applications-at-mobility.gschema.xml:10
